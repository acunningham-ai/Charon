# Per-user accumulated allowlist — never ship
.claude/settings.local.json

# Personal layer for the boot file. CLAUDE.md is tracked and updates arrive by
# `git pull --ff-only`, so a committed edit to it diverges the branch and
# /charon-update refuses to run. Claude Code loads CLAUDE.local.md right after
# CLAUDE.md every session, so personal instructions live here and updates keep
# working.
CLAUDE.local.md

# Derived indexes over YOUR OWN notes. The retrieval index carries note paths
# plus descriptions lifted from note bodies, and the knowledge graph carries
# entity names from the same content — so this is private data, not build
# output. Untracked is not enough: you pull updates into this repo, so a single
# `git add -A` would otherwise commit a searchable digest of your vault.
.charon/

# Runtime state, telemetry, audit logs
state/
**/state/
00-Inbox/_captured/
00-Inbox/_reports/
01-Daily/
05-Meetings/captured/
06-Decisions/
09-Archive/

# Memory directory (user-specific; lives under ~/.claude/projects/<...>/memory/ by default, but if a user co-locates it inside the vault, skip it)
memory/sessions/
memory/*.md
!memory-templates/

# Capture pipeline runtime
capture-pipeline/state/
capture-pipeline/node_modules/
capture-pipeline/*.bak
capture-pipeline/*.corrupt-bak
capture-pipeline/_inflight.json
capture-pipeline/config.json
!capture-pipeline/config.example.json

# Secrets — should never be in the repo regardless of path
**/.secrets/
*.env
.env.*
!.env.example

# Obsidian + binary blobs
.obsidian/
_Attachments/
!_Templates/

# Common cruft
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
